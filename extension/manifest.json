{
  "manifest_version": 3,
  "name": "Teleprompter for ChatGPT",
  "version": "1.4.4",
  "description": "Sends Win+Shift+S screenshots from Teleprompter to ChatGPT, optionally humanizes the answer in Phrasly, and shows it in the bar.",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:38457/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://phrasly.ai/*",
    "https://www.phrasly.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://phrasly.ai/*",
        "https://www.phrasly.ai/*"
      ],
      "js": [
        "phrasly.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
